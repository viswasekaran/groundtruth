# ---- PayPal (sandbox) ----
# Create an app at https://developer.paypal.com/dashboard/applications/sandbox
# Leave blank to run in MOCK mode (no real sandbox calls).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# ---- Anthropic (Claude) ----
# Leave blank to run the agent and the vision check in MOCK mode.
# AI: set ONE of these. Order if several are set: Anthropic, OpenRouter, Gemini (override with AI_PROVIDER=claude|openrouter|gemini|mock).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# OpenRouter (recommended, fast): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ---- App ----
PORT=3000
# Public base URL (used in links shown to agents / MCP clients)
BASE_URL=http://localhost:3000
# API key that external agents (REST / MCP) must send as `x-api-key`
AGENT_API_KEY=change-me-demo-key

# ---- Spending policy (agent firewall) ----
MAX_BOUNTY_USD=10
DAILY_CAP_USD=50
MIN_WALLET_RESERVE_USD=0

# ---- Verification ----
MAX_CAPTURE_AGE_SECONDS=120
DUPLICATE_HAMMING_THRESHOLD=6
# Set to true ONLY for local desktop demos: lets the hunter page use a
# simulated GPS position. Simulated GPS is always flagged and forces manual review.
ALLOW_SIMULATED_GPS=true
